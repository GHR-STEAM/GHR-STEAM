# Package Information for pkg-config

prefix=/workspaces/GHR-STEAM/venv
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: SQLite
Description: SQL database engine
Version: 3.53.3
